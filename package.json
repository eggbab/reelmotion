{
  "name": "reelmotion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config src/pwa/vite.config.ts && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "node e2e/run.cjs",
    "e2e:media": "node e2e/make-media.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "lucide-react": "^1.73.0",
    "mediabunny": "^1.66.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pretendard-jp": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.1",
    "fake-indexeddb": "^6.2.8",
    "hono": "^4.13.18",
    "nodemailer": "10.5.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "4.6.7"
  }
