# ReelMotion 웹. TLS(https)는 앞단(운영 PC 의 공개 주소 설정)이 맡고, 여기서는 80 포트로 받는다.
{
	admin off
	auto_https off
	# 앞단(운영 PC 의 home-edge, 사설 주소)이 알려 준 방문자 주소(X-Forwarded-For)를 믿는다.
	# 앱 서버가 로그인하지 않은 「말로 고치기」 요청을 방문자마다 세는 데 쓴다(메모리에서 10분, 저장 안 함).
	servers {
		trusted_proxies static private_ranges
	}
	# 접속 기록은 남기지 않는다(Caddy 는 log 지시어가 없으면 접속 기록을 쓰지 않는다).
	# 오류 기록에는 요청 정보가 함께 적히므로, 방문자를 알아볼 수 있는 값(IP 주소·포트·머리글)을 지운다.
	# 개인정보처리방침의 「접속 기록을 남기지 않는다」와 맞춘다(src/site/legal/privacy.ts).
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
			}
		}
	}
}

# 모든 응답(404 쪽 포함)에 붙이는 머리글. 오류 응답은 앞에서 붙인 머리글이 지워지므로 handle_errors 에서도 다시 붙인다.
(headers) {
	header {
		# 브라우저 안 받아쓰기가 여러 CPU 를 쓰려면 이 둘이 필요하다(vite.config.ts 의 isolationHeaders 와 같게).
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 다른 사이트가 우리 쪽을 몰래 끼워 넣지 못하게(계정 지우기 단추 위에 덮어씌우는 속임수 막기)
		X-Frame-Options "DENY"
		# https 로만 오게(앞단이 https 를 맡는다 — 브라우저는 https 응답에서만 이 머리글을 따른다). 다른 하위 주소에는 걸지 않는다.
		Strict-Transport-Security "max-age=31536000"
		# 실행해도 되는 것만: 우리 파일과 쪽마다 같은 언어 옮기기 스크립트(해시 — index.html 을 고치면 src/site/csp.test.ts 가 새 값을 알려 준다),
		# 받아쓰기·얼굴 찾기의 wasm, 워커. blob: 은 브라우저 안 받아쓰기가 실행 파일을 그 브라우저 안의 임시 주소로 불러와서 필요하다
		# (2026-11-19 이 규칙을 켜고 브라우저 Whisper 로 확인 — blob: 이 없으면 「받아쓰기가 멈췄어요」).
		# 바깥으로는 브라우저 받아쓰기 모델 파일을 주는 Hugging Face 만(개인정보처리방침과 같게).
		Content-Security-Policy "default-src 'self'; script-src 'self' blob: 'sha256-BB/KjXah2DriE2cVtW8EbZMPxLiHop5+MILWZMf6GFI=' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' blob: https://huggingface.co https://*.huggingface.co https://*.hf.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}

:80 {
	encode zstd gzip

	import headers

	# 받아쓰기 서버(server/asr). 소리 10분 ≈ 19MB 라 25MB 까지 받고, CPU 로 돌 때를 생각해 오래 기다린다.
	handle /api/asr/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy {$ASR_UPSTREAM:asr:8008} {
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	# Claude·ChatGPT 커넥터(MCP)의 바깥 주소. 앱 서버의 /api/mcp 로 넘긴다(server/app/connect.ts). 본문은 작다(대본 글).
	# 주소 끝에 / 를 붙여 넣은 사람도 되게 둘 다 받는다.
	@mcp path /mcp /mcp/
	handle @mcp {
		request_body {
			max_size 128KB
		}
		rewrite * /api/mcp
		reverse_proxy {$APP_UPSTREAM:app:8787}
	}

	# 앱 서버(server/app): 로그인·계정·작업 저장. 응답의 캐시 규칙은 앱 서버가 정한다(no-store).
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy {$APP_UPSTREAM:app:8787}
	}

	# 이름에 내용 지문이 든 파일은 오래 두고, 나머지(HTML 등)는 매번 새 판인지 확인한다.
	# HTML 을 오래 두면 새로 배포한 뒤 지워진 옛 파일을 찾다가 화면이 깨진다.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh not path /assets/* /api/* /mcp /mcp/
	header @fresh Cache-Control "no-cache"

	# 쪽마다 미리 그린 HTML 이 있다(/ko → /ko/index.html). 없는 파일은 아래 404 로 간다.
	handle {
		root * /srv
		try_files {path} {path}/index.html
		file_server
	}

	# 없는 주소: 미리 그려 둔 404 쪽을 404 상태로 보낸다. 언어는 주소 앞말을 따른다(src/site/routes.ts 의 langOfPath).
	handle_errors 404 {
		import headers
		root * /srv
		@ko path /ko /ko/*
		@ja path /ja /ja/*
		rewrite @ko /ko/404.html
		rewrite @ja /ja/404.html
		rewrite * /404.html
		file_server
	}
}
